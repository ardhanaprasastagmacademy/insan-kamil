---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) =>
  b.data.tanggal.getTime() - a.data.tanggal.getTime()
);

const categories = ['Semua', ...new Set(posts.map(p => p.data.kategori))];
---
<BaseLayout title="Blog" description="Artikel dan berita terkini dari Pondok Pesantren Insan Kamil — peternakan, pertanian, pelatihan, dan katering.">
  <div class="container" style="padding-top:var(--space-4);">
    <Breadcrumb items={[{ label: 'Blog' }]} />
  </div>

  <section>
    <div class="container">
      <div class="section-heading" style="text-align:left;">
        <span class="eyebrow">Blog dan Artikel</span>
        <h1>Informasi dan Panduan</h1>
        <span style="display:block;width:48px;height:2px;background:var(--chocolate);margin:var(--space-3) 0 var(--space-5);"></span>
      </div>

      <div class="filter-bar" role="group" aria-label="Filter kategori artikel">
        {categories.map(cat => (
          <button class={`filter-btn ${cat === 'Semua' ? 'is-active' : ''}`} data-filter={cat} type="button">{cat}</button>
        ))}
      </div>

      <div class="blog-grid" id="blog-grid">
        {posts.map(post => {
          const bodyText = post.body || '';
          const readTime = Math.max(1, Math.ceil(bodyText.split(/\s+/).length / 200));
          return (
            <article class="blog-card" data-category={post.data.kategori}>
              <a href={`/blog/${post.id}/`} class="blog-img-link">
                <div class="blog-img" role="img" aria-label={post.data.judul}></div>
              </a>
              <div class="blog-body">
                <span class="eyebrow" style="font-size:0.7rem">{post.data.kategori}</span>
                <h2><a href={`/blog/${post.id}/`}>{post.data.judul}</a></h2>
                <p class="blog-desc">{post.data.deskripsi}</p>
                <div class="blog-meta">
                  <span>{post.data.tanggal.toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'})}</span>
                  <span>·</span>
                  <span>{readTime} menit baca</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.filter-bar { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-7); }
.filter-btn { background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px 20px; font-family: var(--font-body); font-size: 0.9375rem; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all var(--dur-fast) var(--ease); }
.filter-btn:hover { border-color: var(--chocolate-deep); color: var(--chocolate-deep); }
.filter-btn.is-active { background: var(--chocolate-deep); color: var(--mintcream); border-color: var(--chocolate-deep); font-weight: 700; }
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
.blog-card { background: var(--mintcream); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
.blog-card[hidden] { display: none; }
.blog-img-link { display: block; overflow: hidden; }
.blog-img { width: 100%; aspect-ratio: 4/3; background: var(--mint-200); transition: transform var(--dur) var(--ease); }
.blog-img-link:hover .blog-img { transform: scale(1.03); }
.blog-body { padding: var(--space-5); }
.blog-card h2 { font-size: 1.125rem; margin-bottom: var(--space-2); }
.blog-card h2 a { color: var(--chocolate-ink); text-decoration: none; }
.blog-card h2 a:hover { color: var(--chocolate-deep); }
.blog-desc { font-size: 0.875rem; color: var(--text-muted); margin-bottom: var(--space-3); }
.blog-meta { display: flex; gap: var(--space-2); font-size: 0.8125rem; color: var(--text-muted); }
@media (max-width: 991.98px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 575.98px) { .blog-grid { grid-template-columns: 1fr; } }
</style>

<script>
const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
const cards = document.querySelectorAll<HTMLElement>('.blog-card');
filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    const filter = btn.dataset.filter!;
    cards.forEach(card => {
      if (filter === 'Semua' || card.dataset.category === filter) {
        card.removeAttribute('hidden');
      } else {
        card.setAttribute('hidden', '');
      }
    });
  });
});
</script>

