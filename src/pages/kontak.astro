---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site.js';
---
<BaseLayout title="Kontak" description="Hubungi Pondok Pesantren Insan Kamil untuk informasi program, pemesanan, dan kerjasama.">
  <div class="container" style="padding-top:var(--space-4);">
    <Breadcrumb items={[{ label: 'Kontak' }]} />
  </div>

  <section>
    <div class="container">
      <span class="eyebrow">Hubungi Kami</span>
      <h1>Kontak Pondok Pesantren Insan Kamil</h1>
      <span style="display:block;width:48px;height:2px;background:var(--chocolate);margin:var(--space-3) 0 var(--space-7);"></span>

      <div class="kontak-grid">
        <!-- Info -->
        <div class="kontak-info">
          <div class="info-card">
            <h2>Alamat</h2>
            <p>{site.address}</p>
          </div>
          <div class="info-card">
            <h2>Jam Layanan</h2>
            <p>{site.hours}</p>
          </div>
          <div class="info-card">
            <h2>WhatsApp</h2>
            <a href={`https://wa.me/${site.waNumber}`} target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:var(--space-3);display:inline-flex;">Buka WhatsApp</a>
          </div>
          <div class="info-card">
            <h2>Media Sosial</h2>
            <div class="sosial-links">
              <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
              <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
              <a href={site.social.youtube} target="_blank" rel="noopener">YouTube</a>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="kontak-form-wrap">
          <h2>Kirim Pesan</h2>
          <p style="color:var(--text-muted);margin-bottom:var(--space-5);">Isi formulir di bawah. Pesan akan diteruskan ke WhatsApp kami.</p>
          <form id="kontak-form" class="kontak-form" novalidate>
            <div class="form-group">
              <label for="nama">Nama Lengkap</label>
              <input type="text" id="nama" name="nama" required placeholder="Nama Anda" />
              <span class="form-error" id="nama-error"></span>
            </div>
            <div class="form-group">
              <label for="keperluan">Keperluan</label>
              <select id="keperluan" name="keperluan" required>
                <option value="">Pilih keperluan</option>
                <option value="pelatihan kerja">Pelatihan Kerja</option>
                <option value="domba">Peternakan Domba</option>
                <option value="katering">Katering</option>
                <option value="bibit alpukat">Bibit Alpukat</option>
                <option value="informasi umum">Informasi Umum</option>
                <option value="kerjasama">Kerjasama / Kemitraan</option>
              </select>
              <span class="form-error" id="keperluan-error"></span>
            </div>
            <div class="form-group">
              <label for="pesan">Pesan</label>
              <textarea id="pesan" name="pesan" rows="5" required placeholder="Tuliskan pesan atau pertanyaan Anda..."></textarea>
              <span class="form-error" id="pesan-error"></span>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">Kirim via WhatsApp</button>
          </form>
        </div>
      </div>

      <!-- Peta -->
      <div class="peta-wrap">
        <iframe
          src="https://maps.google.com/maps?q=-6.5,106.8&z=14&output=embed"
          width="100%" height="400"
          style="border:1px solid var(--line);border-radius:var(--radius-md);"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lokasi Pondok Pesantren Insan Kamil"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.kontak-grid { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-7); margin-bottom: var(--space-7); }
.kontak-info { display: flex; flex-direction: column; gap: var(--space-5); }
.info-card { padding: var(--space-5); background: var(--mint-100); border: 1px solid var(--line); border-radius: var(--radius-md); }
.info-card h2 { font-size: 1rem; font-weight: 700; margin-bottom: var(--space-2); color: var(--chocolate-deep); }
.info-card p { margin: 0; font-size: 0.9375rem; color: var(--text-muted); }
.sosial-links { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-2); }
.sosial-links a { color: var(--chocolate-deep); font-weight: 600; text-decoration: none; font-size: 0.9375rem; }
.sosial-links a:hover { text-decoration: underline; }
.kontak-form-wrap h2 { font-size: 1.5rem; margin-bottom: var(--space-2); }
.kontak-form { display: flex; flex-direction: column; gap: var(--space-5); }
.form-group { display: flex; flex-direction: column; gap: var(--space-2); }
.form-group label { font-size: 0.9375rem; font-weight: 600; color: var(--chocolate-ink); }
.form-group input, .form-group select, .form-group textarea {
  background: var(--mint-100); border: 1px solid var(--line); border-radius: var(--radius-sm);
  padding: 12px 16px; font-family: var(--font-body); font-size: 1rem; color: var(--text);
  transition: border-color var(--dur-fast) var(--ease);
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
  outline: none; border: 2px solid var(--chocolate-deep);
}
.form-error { font-size: 0.875rem; color: var(--chocolate-deep); min-height: 1.2em; }
.peta-wrap { margin-top: var(--space-7); }
@media (max-width: 991.98px) { .kontak-grid { grid-template-columns: 1fr; } }
</style>

<script>
const form = document.getElementById('kontak-form') as HTMLFormElement | null;
if (form) {
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const nama = (document.getElementById('nama') as HTMLInputElement).value.trim();
    const keperluan = (document.getElementById('keperluan') as HTMLSelectElement).value;
    const pesan = (document.getElementById('pesan') as HTMLTextAreaElement).value.trim();
    let valid = true;

    const namaError = document.getElementById('nama-error')!;
    const keperluanError = document.getElementById('keperluan-error')!;
    const pesanError = document.getElementById('pesan-error')!;

    namaError.textContent = '';
    keperluanError.textContent = '';
    pesanError.textContent = '';

    if (!nama) { namaError.textContent = 'Nama tidak boleh kosong.'; valid = false; }
    if (!keperluan) { keperluanError.textContent = 'Pilih keperluan Anda.'; valid = false; }
    if (!pesan) { pesanError.textContent = 'Pesan tidak boleh kosong.'; valid = false; }

    if (valid) {
      const text = `Assalamu'alaikum, saya ${nama} ingin bertanya tentang ${keperluan} dari website Pondok Pesantren Insan Kamil.\n\n${pesan}`;
      window.open(`https://wa.me/6281234567890?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    }
  });
}
</script>
