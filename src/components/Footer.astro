---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <p class="footer-brand">Insan Kamil</p>
      <p class="footer-desc">{site.description}</p>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Program</p>
      <ul>
        <li><a href="/program/pelatihan-kerja/">Pelatihan Kerja</a></li>
        <li><a href="/program/peternakan-domba/">Peternakan Domba</a></li>
        <li><a href="/program/katering/">Katering</a></li>
        <li><a href="/program/bibit-alpukat/">Bibit Alpukat</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Tautan</p>
      <ul>
        <li><a href="/tentang/">Tentang Kami</a></li>
        <li><a href="/galeri/">Galeri</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/kontak/">Kontak</a></li>
        <li><a href="/kebijakan-privasi/">Kebijakan Privasi</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Kontak</p>
      <p class="footer-address">{site.address}</p>
      <p class="footer-hours">{site.hours}</p>
      <a href={`https://wa.me/${site.waNumber}`} class="footer-wa" target="_blank" rel="noopener">WhatsApp</a>
      <div class="footer-social">
        <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={site.social.youtube} target="_blank" rel="noopener">YouTube</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Pondok Pesantren Insan Kamil. Hak cipta dilindungi.</p>
    </div>
  </div>
</footer>

<style>
.site-footer { background: var(--chocolate-deep); color: var(--mintcream); padding-top: var(--space-9); }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: var(--space-7); margin-bottom: var(--space-7); }
.footer-brand { font-family: var(--font-heading); font-size: 1.75rem; font-weight: 700; margin: 0 0 var(--space-3); }
.footer-desc { font-size: 0.9375rem; line-height: 1.65; opacity: 0.85; margin: 0; max-width: 28ch; }
.footer-heading { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.7; margin: 0 0 var(--space-4); }
.footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.footer-col a { color: var(--mintcream); text-decoration: none; font-size: 0.9375rem; opacity: 0.85; }
.footer-col a:hover { font-weight: 700; opacity: 1; }
.footer-address { font-size: 0.9375rem; line-height: 1.65; opacity: 0.85; margin: 0 0 var(--space-2); }
.footer-hours { font-size: 0.875rem; opacity: 0.7; margin: 0 0 var(--space-4); }
.footer-wa { display: inline-block; color: var(--mintcream); font-weight: 700; text-decoration: none; margin-bottom: var(--space-4); font-size: 1rem; }
.footer-wa:hover { text-decoration: underline; }
.footer-social { display: flex; gap: var(--space-4); flex-wrap: wrap; }
.footer-social a { font-size: 0.875rem; color: var(--mintcream); text-decoration: none; opacity: 0.75; }
.footer-social a:hover { opacity: 1; font-weight: 600; }
.footer-bottom { border-top: 1px solid var(--line-on-dark); padding-block: var(--space-5); }
.footer-bottom p { margin: 0; font-size: 0.875rem; opacity: 0.65; text-align: center; }

@media (max-width: 991.98px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
}
@media (max-width: 575.98px) {
  .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  .footer-desc { max-width: 100%; }
}
</style>
