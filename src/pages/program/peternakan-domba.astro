---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const dombas = await getCollection('domba');
const kegunaan = ['Semua', 'kurban', 'aqiqah', 'bibit', 'potong'];

const faqs = [
  { q: 'Berapa harga domba kurban?', a: 'Harga domba kurban mulai dari Rp 1.800.000 untuk domba ekor tipis betina hingga Rp 4.800.000+ untuk domba Merino/Garut jantan. Hubungi kami untuk harga terkini karena harga dapat berubah.' },
  { q: 'Apakah ada layanan antar domba?', a: 'Ya, kami menyediakan layanan antar domba untuk wilayah Kabupaten Bogor dan sekitarnya. Biaya antar disesuaikan dengan jarak.' },
  { q: 'Apakah bisa memesan jauh-jauh hari sebelum Iduladha?', a: 'Sangat disarankan untuk memesan minimal 2 minggu sebelum Iduladha untuk memastikan ketersediaan dan bobot yang diinginkan.' },
  { q: 'Bagaimana cara memastikan domba sehat sebelum kurban?', a: 'Seluruh domba kami diperiksa secara rutin oleh petugas ternak. Kami menjamin domba dalam kondisi sehat, cukup umur, dan bebas cacat saat diserahkan.' },
];
---
<BaseLayout title="Peternakan Domba" description="Domba Garut dan lokal berkualitas untuk kurban, aqiqah, bibit, dan potong. Peternakan modern Pondok Pesantren Insan Kamil.">
  <div class="container" style="padding-top:var(--space-4);">
    <Breadcrumb items={[{ label: 'Program', href: '/program/' }, { label: 'Peternakan Domba' }]} />
  </div>

  <section>
    <div class="container">
      <span class="eyebrow">Peternakan</span>
      <h1>Peternakan Domba Insan Kamil</h1>
      <span style="display:block;width:48px;height:2px;background:var(--chocolate);margin:var(--space-3) 0 var(--space-5);"></span>
      <p class="answer-box">Peternakan domba modern dengan kandang higienis dan sistem perawatan terstandar. Menyediakan domba Garut, Ekor Tipis, dan Merino untuk kurban, aqiqah, bibit, dan potong. Hubungi kami untuk konsultasi dan pemesanan.</p>
    </div>
  </section>

  <!-- Profil Kandang -->
  <section class="bg-mint">
    <div class="container">
      <div class="kandang-grid">
        <div class="kandang-visual" role="img" aria-label="Kandang domba Insan Kamil"></div>
        <div>
          <span class="eyebrow">Profil Peternakan</span>
          <h2>Kandang Modern, Perawatan Terstandar</h2>
          <span style="display:block;width:48px;height:2px;background:var(--chocolate);margin:var(--space-3) 0 var(--space-4);"></span>
          <p>Kandang kami dirancang dengan sirkulasi udara yang baik dan sistem pembersihan rutin untuk menjaga kesehatan domba. Kapasitas 100+ ekor dengan petugas ternak berpengalaman.</p>
          <ul class="kandang-features">
            <li>Pakan berkualitas — hijauan segar dan konsentrat bergizi</li>
            <li>Pemeriksaan kesehatan rutin</li>
            <li>Sistem kandang higienis dan berventilasi</li>
            <li>Domba dipelihara bebas stres</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Katalog Domba -->
  <section>
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Katalog</span>
        <h2>Domba Tersedia</h2>
        <span class="accent-line"></span>
      </div>

      <div class="filter-bar" role="group" aria-label="Filter kegunaan domba">
        {kegunaan.map(k => (
          <button class={`filter-btn ${k === 'Semua' ? 'is-active' : ''}`} data-filter={k} type="button">
            {k === 'Semua' ? 'Semua' : k.charAt(0).toUpperCase() + k.slice(1)}
          </button>
        ))}
      </div>

      <div class="domba-grid" id="domba-grid">
        {dombas.map(d => (
          <article class="produk-card" data-kegunaan={d.data.kegunaan.join(',')}>
            <div class="produk-img" role="img" aria-label={`Foto ${d.data.nama}`}></div>
            <div class="produk-body">
              <div class="produk-header">
                <h3>{d.data.nama}</h3>
                <span class={`stok-badge ${d.data.stok === 'tersedia' ? 'stok-ok' : 'stok-habis'}`}>
                  {d.data.stok === 'tersedia' ? 'Tersedia' : 'Habis'}
                </span>
              </div>
              <p class="produk-meta">{d.data.jenis} · {d.data.bobotMin}–{d.data.bobotMax} kg · {d.data.umur}</p>
              <p class="produk-tags">{d.data.kegunaan.map(k => k.charAt(0).toUpperCase() + k.slice(1)).join(', ')}</p>
              <p class="produk-harga">Rp {d.data.harga.toLocaleString('id-ID')}</p>
              <a href={`https://wa.me/6281234567890?text=${encodeURIComponent(`Assalamu'alaikum, saya ingin menanyakan ${d.data.nama} dari website Pondok Pesantren Insan Kamil.`)}`}
                 class="produk-link" target="_blank" rel="noopener">Tanya Domba Ini</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Layanan -->
  <section class="bg-mint">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Layanan</span>
        <h2>Kurban dan Aqiqah</h2>
        <span class="accent-line"></span>
      </div>
      <div class="layanan-grid">
        <div class="layanan-card">
          <p class="layanan-num">01</p>
          <h3>Layanan Kurban</h3>
          <p>Domba jantan cukup umur (minimal 1 tahun) dengan bobot ideal untuk kurban. Tersedia layanan antar ke lokasi penyembelihan.</p>
        </div>
        <div class="layanan-card">
          <p class="layanan-num">02</p>
          <h3>Layanan Aqiqah</h3>
          <p>Domba jantan dan betina sesuai ketentuan aqiqah. Konsultasikan kebutuhan Anda dengan tim kami.</p>
        </div>
        <div class="layanan-card">
          <p class="layanan-num">03</p>
          <h3>Layanan Antar</h3>
          <p>Layanan pengiriman domba ke lokasi Anda di wilayah Kabupaten Bogor dan sekitarnya. Biaya disesuaikan jarak.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="container container-narrow">
      <div class="section-heading">
        <span class="eyebrow">Pertanyaan Umum</span>
        <h2>FAQ Domba</h2>
        <span class="accent-line"></span>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <div class="faq-item">
            <button class="faq-btn" type="button" aria-expanded="false" aria-controls={`dfaq-${i}`}>
              <span>{faq.q}</span><span class="faq-icon" aria-hidden="true"></span>
            </button>
            <div class="faq-answer" id={`dfaq-${i}`} hidden>
              <p>{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-dark">
    <div class="container cta-center">
      <span class="eyebrow" style="color:rgba(245,255,250,0.7)">Hubungi Kami</span>
      <h2 style="color:var(--mintcream)">Pesan Domba Sekarang</h2>
      <span style="display:block;width:48px;height:2px;background:var(--mintcream);margin:var(--space-3) auto var(--space-5);"></span>
      <a href={`https://wa.me/6281234567890?text=${encodeURIComponent("Assalamu'alaikum, saya ingin memesan domba dari website Pondok Pesantren Insan Kamil.")}`}
         class="btn btn-on-dark" target="_blank" rel="noopener">Tanya via WhatsApp</a>
    </div>
  </section>
</BaseLayout>

<style>
.answer-box { font-size: 1.0625rem; max-width: 70ch; color: var(--text-muted); background: var(--mint-100); border-left: 3px solid var(--chocolate); padding: var(--space-5); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
.kandang-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-9); align-items: center; }
.kandang-visual { width: 100%; aspect-ratio: 4/3; background: var(--mint-200); border-radius: var(--radius-md); }
.kandang-features { margin: var(--space-4) 0 0; padding-left: var(--space-5); color: var(--text-muted); font-size: 0.9375rem; }
.kandang-features li { margin-bottom: var(--space-2); }
.filter-bar { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-7); }
.filter-btn { background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px 20px; font-family: var(--font-body); font-size: 0.9375rem; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all var(--dur-fast) var(--ease); }
.filter-btn:hover { border-color: var(--chocolate-deep); color: var(--chocolate-deep); }
.filter-btn.is-active { background: var(--chocolate-deep); color: var(--mintcream); border-color: var(--chocolate-deep); font-weight: 700; }
.domba-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
.produk-card { background: var(--mintcream); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
.produk-card[hidden] { display: none; }
.produk-img { width: 100%; aspect-ratio: 4/3; background: var(--mint-200); }
.produk-body { padding: var(--space-5); }
.produk-header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-2); }
.produk-card h3 { font-size: 1.125rem; margin: 0; }
.stok-badge { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 2px; border: 1px solid; white-space: nowrap; flex-shrink: 0; }
.stok-ok { color: var(--chocolate-deep); border-color: var(--chocolate-deep); }
.stok-habis { color: var(--text-muted); border-color: var(--text-muted); }
.produk-meta { font-size: 0.875rem; color: var(--text-muted); margin: 0 0 var(--space-1); }
.produk-tags { font-size: 0.8125rem; color: var(--text-muted); margin: 0 0 var(--space-3); }
.produk-harga { font-size: 1.25rem; font-weight: 700; color: var(--chocolate-deep); margin: 0 0 var(--space-4); }
.produk-link { color: var(--chocolate-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 5px; font-size: 0.9375rem; }
.layanan-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
.layanan-card { padding: var(--space-6); background: var(--mintcream); border: 1px solid var(--line); border-radius: var(--radius-md); }
.layanan-num { font-family: var(--font-heading); font-size: 2.5rem; color: var(--chocolate); margin: 0 0 var(--space-3); line-height: 1; }
.layanan-card h3 { font-size: 1.125rem; margin-bottom: var(--space-3); }
.layanan-card p { font-size: 0.9375rem; color: var(--text-muted); margin: 0; }
.faq-list { border-top: 1px solid var(--line); }
.faq-item { border-bottom: 1px solid var(--line); }
.faq-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-5) 0; background: transparent; border: 0; text-align: left; font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--chocolate-ink); cursor: pointer; }
.faq-icon { position: relative; width: 20px; height: 20px; flex-shrink: 0; }
.faq-icon::before, .faq-icon::after { content: ''; position: absolute; top: 50%; left: 50%; background: var(--chocolate-deep); transform: translate(-50%, -50%); transition: transform var(--dur) var(--ease), opacity var(--dur); }
.faq-icon::before { width: 16px; height: 1.5px; }
.faq-icon::after { width: 1.5px; height: 16px; }
.faq-btn[aria-expanded='true'] .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
.faq-answer { padding-bottom: var(--space-5); }
.faq-answer p { margin: 0; color: var(--text-muted); font-size: 0.9375rem; }
.cta-center { text-align: center; }
@media (max-width: 991.98px) { .kandang-grid, .domba-grid, .layanan-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 575.98px) { .kandang-grid, .domba-grid, .layanan-grid { grid-template-columns: 1fr; } }
</style>

<script>
document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    const filter = btn.dataset.filter!;
    document.querySelectorAll<HTMLElement>('.produk-card').forEach(card => {
      const kegunaan = (card.dataset.kegunaan || '').split(',');
      if (filter === 'Semua' || kegunaan.includes(filter)) {
        card.removeAttribute('hidden');
      } else {
        card.setAttribute('hidden', '');
      }
    });
  });
});
document.querySelectorAll<HTMLButtonElement>('.faq-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    const id = btn.getAttribute('aria-controls')!;
    const el = document.getElementById(id)!;
    if (expanded) el.setAttribute('hidden', ''); else el.removeAttribute('hidden');
  });
});
</script>
